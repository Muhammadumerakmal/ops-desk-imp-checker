# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored and must never be committed (NFR-1).

# The API key the Ops Desk uses to talk to the model provider.
OPENAI_API_KEY=sk-your-key-here

# Optional: a separate key used ONLY to export traces to the provider's
# dashboard. If unset, the code falls back to OPENAI_API_KEY (FR-13, NFR-3).
# TRACING_EXPORT_API_KEY=sk-your-key-here
